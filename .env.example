# Copia este archivo a ".env" (mismo directorio) y completa los valores
# reales. ".env" (ya está en .gitignore).

DB_NAME=institucion_db
DB_USERNAME=postgres
DB_PASSWORD=cambia-esta-clave

JWT_ISSUER_URI=https://login.microsoftonline.com/bfbc730b-74fb-4552-b74c-c93431273927/v2.0

# Origenes permitidos por CORS, separados por coma (sin espacios).
# Agrega aqui el/los dominio(s) del front publico cuando los tengas.
CORS_ALLOWED_ORIGINS=http://localhost:4200,http://localhost:5173

# Imagen a usar (la publica el pipeline de CI/CD en cada push a main).
# En local con "docker compose up --build" este valor no se usa.
IMAGE=ghcr.io/alvmaltrain/api-athenet-institution:latest
